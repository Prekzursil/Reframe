{
  "name": "@media-studio/render-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion render CLI for media-studio premium captions. Self-contained workspace: compositions are bundled at APP-BUILD time (bundle.ts); at runtime the sidecar spawns render.js under the Electron exe with ELECTRON_RUN_AS_NODE=1 and a JSON job file. Do NOT merge these deps into app/package.json.",
  "license": "UNLICENSED",
  "main": "dist/render.js",
  "scripts": {
    "build": "tsc -p .",
    "bundle": "npm run build && node dist/bundle.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "4.0.506",
    "@remotion/renderer": "4.0.506",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.506",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.506",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "fast-uri": "^3.1.5",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.18",
    "ws": "^8.21.0"
  }
}
